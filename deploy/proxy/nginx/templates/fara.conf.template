# ────────────────────────────────────────────────────────────────
# Reverse-proxy для FARA CRM
# По образцу fara_landing/nginx.conf, адаптировано под две цели:
#   /api/* → backend (со снятием префикса)
#   /     → frontend
# Шаблон. Реальный конфиг генерируется скриптом deploy.sh
# в nginx/conf.d/fara.conf на основе .env
# ────────────────────────────────────────────────────────────────

# DNS-резолвер встроенный в Docker (127.0.0.11). Нужен, потому что в
# location ~ ^/api/(.*)$ proxy_pass содержит переменную $1, и nginx
# переключается в runtime-резолвинг — без resolver падает с ошибкой
# "no resolver defined to resolve backend" → 502.
resolver 127.0.0.11 valid=10s ipv6=off;

# Поддержка WebSocket: если клиент шлёт Upgrade — пробрасываем upgrade,
# иначе оставляем стандартный keep-alive. Без этого map обычные HTTP-
# запросы получают пустой Connection и backend часто отвечает 502.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${SERVER_NAMES};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAMES};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # Предел одного запроса, а не файла: файлы грузятся частями по 8 МБ,
    # размер файла (attachments.max_upload_size) держит бэкенд. 32 МБ —
    # часть с запасом и шаблон DOCX в предпросмотре конструктора отчётов.
    # То же значение — в docker/nginx.conf.
    client_max_body_size 32m;

    # Таймауты — между двумя чтениями/записями, а не на весь запрос.
    # 300 с — отчётам, импорту и сохранению записи с файлом (отправка
    # файла в облачное хранилище пока идёт внутри этого запроса).
    proxy_read_timeout    300s;
    proxy_connect_timeout 30s;
    proxy_send_timeout    300s;

    # Прячем заголовки безопасности от внутреннего nginx во frontend-образе,
    # чтобы не было дублей с нашими.
    proxy_hide_header X-Frame-Options;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header Referrer-Policy;

    # ── /ws/* → backend (WebSocket для чата) ───────────────────────
    # Backend публикует WebSocket на /ws/chat (без /api префикса).
    # Фронт ходит на wss://домен/ws/chat?token=... — путь идёт напрямую.
    location ~ ^/ws(/|$) {
        # Хост в переменной — runtime-resolver требует этого, см. resolver наверху.
        set $backend_ws_upstream "backend:8000";
        proxy_pass http://$backend_ws_upstream;

        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket долгоживущий — таймауты на чтение нужны большие,
        # иначе nginx будет рвать idle-соединение через proxy_read_timeout.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ── /api/* → backend (со снятием префикса) ─────────────────────
    # FastAPI публикует роуты без /api префикса (/signin, /sessions/, ...).
    # Фронт клеит /api/ через baseQuery.baseUrl — здесь его снимаем.
    location ~ ^/api/(.*)$ {
        # Хост в переменной — чтобы корректно работал runtime-resolver выше.
        set $backend_upstream "backend:8000";
        proxy_pass http://$backend_upstream/$1$is_args$args;

        proxy_http_version 1.1;

        # WebSocket — Upgrade/Connection через map, см. наверху файла
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Где у этого nginx файлстор (location /filestore/ ниже): с этим
        # заголовком бэкенд не отдаёт файл сам, а отвечает X-Accel-Redirect.
        # proxy_set_header перезаписывает значение, присланное клиентом
        proxy_set_header X-Accel-Mapping   /app/filestore/=/filestore/;

        # Ответ не буферизуем: большой файл идёт клиенту потоком (Range
        # проходит насквозь), без временных файлов nginx на диске.
        proxy_buffering off;
    }

    # ── Файлы вложений (X-Accel-Redirect) ──────────────────────────
    # Файл с диска отдаёт nginx: бэкенд проверяет права и отвечает
    # X-Accel-Redirect: /filestore/<путь> (видит X-Accel-Mapping из
    # location /api/). internal — снаружи сюда не зайти. Том файлстора FARA
    # смонтирован только на чтение (FARA_FILESTORE_VOLUME).
    # То же — в docker/nginx.conf.
    location ^~ /filestore/ {
        internal;
        alias /app/filestore/;
    }

    # ── / → frontend (всё остальное, включая SPA-роутинг) ──────────
    # Хост в переменной + resolver наверху → nginx резолвит frontend
    # В РАНТАЙМЕ, а не на старте. Иначе, если контейнер frontend не
    # резолвится в момент запуска/reload nginx, весь proxy падает с
    # "[emerg] host not found in upstream frontend" и не поднимается.
    # С переменной вместо этого будет 502, пока фронт не поднимется.
    location / {
        set $frontend_upstream "frontend:80";
        proxy_pass http://$frontend_upstream;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── Security headers ───────────────────────────────────────────
    # CSP в одну строку — HTTP/2 запрещает переносы внутри значений.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; connect-src 'self' wss://$host; font-src 'self' data: https://fonts.gstatic.com; media-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';" always;

    add_header X-Content-Type-Options "nosniff"                       always;
    add_header X-Frame-Options        "DENY"                          always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

    # HSTS — раскомментировать через 1-2 недели стабильной работы
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
}
